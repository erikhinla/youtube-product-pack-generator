# Copy to .env (same folder) and fill in. NEVER commit .env.
# Option A: Anthropic direct
ANTHROPIC_API_KEY=
*** Option B: Abliterated or other Anthropic-compatible proxy (wins over A if both set)
ANTHROPIC_AUTH_TOKEN=
ANTHRO…url>
ANTHROPIC_MODEL=
# Option C: Higgsfield (for the video lane, not needed by the text pipeline)
HIGGSFIELD_API_KEY=
